# ==============================================================================
# Ledger Horizon — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ==============================================================================

# Modo da aplicação
APP_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Autenticação Multi-Tenant
# ENABLE_AUTH=False → modo demo sem login (padrão para primeiro deploy)
# ENABLE_AUTH=True  → autenticação obrigatória (ativar após validar a subida)
# ------------------------------------------------------------------------------
ENABLE_AUTH=False
SECRET_KEY=GERE_COM_python3_-c_"import_secrets;_print(secrets.token_hex(64))"
# COOKIE_SECURE=True apenas quando houver HTTPS/TLS na frente da aplicação (Nginx, Caddy, etc.)
COOKIE_SECURE=False

# ------------------------------------------------------------------------------
# Banco de Dados PostgreSQL 16
# Em Docker: POSTGRES_HOST deve ser o nome do container na rede compartilhada
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_DB=main_db
POSTGRES_USER=usr_pedro
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=10

# Google OAuth 2.0 (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# APIs do Motor de Consenso Multi-IA
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

MISTRAL_API_KEY=
MISTRAL_MODEL=open-mistral-7b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RECALCULATE=3/hour

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

USER_DISPLAY_NAME=Pedro Silva
