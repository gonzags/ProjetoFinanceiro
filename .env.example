# ==============================================================================
# Ledger Horizon - Plataforma Analítica Financeira
# Modelo de Variáveis de Ambiente (.env)
# ==============================================================================

# Configurações da Aplicação
APP_ENV=development
DEBUG=False
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ENABLE_AUTH=False

# Banco de Dados PostgreSQL 16 (Debian 12 / Docker Compose)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ledger_horizon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=10

# ------------------------------------------------------------------------------
# As 5 APIs de IA Gratuitas (Sem Cartão de Crédito - claudeaudita.pdf)
# ------------------------------------------------------------------------------

# 1. Groq (Llama 3.3 70B - Propositor / Gerador Rápido ~30 RPM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Gemini Flash - Auditor de Risco e Raciocínio Profundo)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Mistral AI (Tier Gratuito / Experiment - Sanity Check)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# 4. OpenRouter (Modelos :free - Camada de Fallback Multi-Modelo)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5. Cloudflare Workers AI (Agente Sintetizador e Desempate)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct

# Rate Limiting (SlowAPI)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RECALCULATE=3/hour
