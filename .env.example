# =============================================================================
# Ledger Horizon - Variáveis de Ambiente e Configuração
# =============================================================================

# Modo de Autenticação Multi-Tenant (False = público/demo, True = autenticação obrigatória)
ENABLE_AUTH=False

# Chave secreta para assinatura criptográfica de cookies (itsdangerous) e CSRF
SECRET_KEY=lh-substitua-por-uma-chave-aleatoria-em-producao-64bytes

# Definir como True quando rodar sob HTTPS em produção
COOKIE_SECURE=False

# Data Warehouse / Banco de Dados PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=main_db
POSTGRES_USER=usr_pedro
POSTGRES_PASSWORD=sua_senha_aqui

# Integração Defensiva com Google OAuth 2.0 (Opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate Limiting (SlowAPI)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RECALCULATE=3/hour

# Origens permitidas para CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8200,http://127.0.0.1:8200

# Nome de exibição padrão para modo demo
USER_DISPLAY_NAME=Pedro Silva

# Modo de depuração (ativa documentação OpenAPI em /docs se True)
DEBUG=False
